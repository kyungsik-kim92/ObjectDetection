<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_text_scan"
    app:startDestination="@id/permissionFragment">

    <fragment
        android:id="@+id/permissionFragment"
        android:name="com.example.presentation.ui.search.detect.PermissionFragment"
        android:label="PermissionFragment">
        <action
            android:id="@+id/action_permission_to_textScan"
            app:destination="@id/textScanFragment"
            app:popUpTo="@id/permissionFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/textScanFragment"
        android:name="com.example.presentation.ui.search.text.TextScanFragment"
        android:label="TextScanFragment">
        <action
            android:id="@+id/action_textScan_to_permission"
            app:destination="@id/permissionFragment" />
    </fragment>

</navigation>